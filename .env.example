# fixture: offline placeholders (default, used by tests)
# replay:  offline, serves pages and extractions recorded from a real run
# live:    real search + HTTP + local model
# record:  live, and overwrites tests/fixtures/recorded/ (review the diff before committing)
EVIDENCEGRAPH_TOOL_MODE=fixture
EVIDENCEGRAPH_MAX_PAGES_PER_COUNTRY=3
EVIDENCEGRAPH_RECURSION_LIMIT=12

# Search. Copy this file to .env and put the real key THERE, never here.
# .env is gitignored. Committing a real key here would publish it.
# Without a key, live mode uses the hand-verified seed_urls in countries.py.
# EVIDENCEGRAPH_TAVILY_API_KEY=
EVIDENCEGRAPH_SEARCH_MAX_RESULTS=5

# Fetch limits
EVIDENCEGRAPH_FETCH_TIMEOUT_S=20
EVIDENCEGRAPH_FETCH_MAX_BYTES=3000000
EVIDENCEGRAPH_PAGE_MAX_CHARS=40000

# Extraction model (local, via Ollama)
EVIDENCEGRAPH_OLLAMA_BASE_URL=http://localhost:11434
EVIDENCEGRAPH_OLLAMA_MODEL=llama3.1:8b
EVIDENCEGRAPH_OLLAMA_NUM_CTX=8192
EVIDENCEGRAPH_MODEL_TIMEOUT_S=180
EVIDENCEGRAPH_EXTRACT_MAX_CHARS=12000
EVIDENCEGRAPH_EXTRACT_MAX_ATTEMPTS=2

# Auth. Production verifies tokens from an IdP. Locally, mint one with:
#   uv run python -m evidence_graph.auth --user local --role researcher
EVIDENCEGRAPH_JWT_SECRET=changeme
# EVIDENCEGRAPH_JWT_ISSUER=
# EVIDENCEGRAPH_JWT_AUDIENCE=
EVIDENCEGRAPH_DAILY_RUN_QUOTA=20

# Persistent threads and checkpoints. Omit to keep them in memory (default, tests).
# Requires: uv sync --extra postgres
# EVIDENCEGRAPH_DATABASE_URL=postgresql://localhost:5432/evidencegraph
